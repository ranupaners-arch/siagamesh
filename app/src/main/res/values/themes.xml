<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Parent platform beda untuk mode gelap: lihat values-night/themes.xml. -->
    <style name="Theme.SiagaMesh.Platform" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.SiagaMesh.Base" parent="Theme.SiagaMesh.Platform">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:buttonStyle">@style/Widget.SiagaMesh.Button</item>
        <item name="android:editTextStyle">@style/Widget.SiagaMesh.EditText</item>
    </style>

    <style name="Theme.SiagaMesh" parent="Theme.SiagaMesh.Base" />

    <style name="Widget.SiagaMesh.Button" parent="android:Widget.Material.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.SiagaMesh.Button.Secondary">
        <item name="android:textColor">@color/primary</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
    </style>

    <style name="Widget.SiagaMesh.EditText" parent="android:Widget.Material.EditText">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Text.SiagaMesh" parent="android:TextAppearance" />

    <style name="Text.SiagaMesh.Title">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Text.SiagaMesh.Heading">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Text.SiagaMesh.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Text.SiagaMesh.Muted" parent="Text.SiagaMesh.Body">
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="Text.SiagaMesh.Status" parent="Text.SiagaMesh.Body">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>

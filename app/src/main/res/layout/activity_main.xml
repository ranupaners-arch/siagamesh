<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/Text.SiagaMesh.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            tools:targetApi="p"
            android:text="@string/app_name" />

        <!-- Peringatan izin: ikon + teks + warna, tidak hanya warna -->
        <LinearLayout
            android:id="@+id/permission_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_warning"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                style="@style/Text.SiagaMesh.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/ic_warning"
                android:text="@string/permission_warning" />

            <Button
                android:id="@+id/permission_fix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/permission_fix" />
        </LinearLayout>

        <!-- Profil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.SiagaMesh.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_heading" />

            <TextView
                android:id="@+id/display_name"
                style="@style/Text.SiagaMesh.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="22sp" />

            <TextView
                style="@style/Text.SiagaMesh.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/device_id_label" />

            <TextView
                android:id="@+id/device_id"
                style="@style/Text.SiagaMesh.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="18sp" />

            <Button
                android:id="@+id/edit_name"
                style="@style/Widget.SiagaMesh.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/edit_name" />
        </LinearLayout>

        <!-- Mesh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.SiagaMesh.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mesh_heading" />

            <TextView
                android:id="@+id/mesh_status"
                style="@style/Text.SiagaMesh.Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/mesh_off" />

            <Button
                android:id="@+id/mesh_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/mesh_start" />
        </LinearLayout>

        <TextView
            style="@style/Text.SiagaMesh.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/coming_soon" />

        <TextView
            android:id="@+id/version"
            style="@style/Text.SiagaMesh.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
